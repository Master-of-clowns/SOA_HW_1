  "components": {
    "securitySchemes": {"BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "schemas": {
      "ProductCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 255},
          "description": {"type": "string", "maxLength": 4000, "nullable": true},
          "price": {"type": "number", "format": "decimal", "minimum": 0.01, "maximum": 9999999999.99, "multipleOf": 0.01},
          "stock": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "category": {"type": "string", "minLength": 1, "maxLength": 100},
          "status": {"type": "string", "enum": ["ACTIVE", "INACTIVE", "ARCHIVED"]},
          "seller_id": {"type": "string", "format": "uuid", "nullable": true}
        },
        "required": ["name", "price", "stock", "category", "status"]
      },
      "ProductUpdate": {
        "type": "object",
